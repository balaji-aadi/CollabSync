# ==============================================================================
# CollabSync Environment Configuration Template
# Copy this file to .env before starting the application: cp .env.example .env
# ==============================================================================

# Server Network Configuration
PORT=5005
NODE_ENV=development

# Client Origin (CORS and Socket.IO allowed origins)
CLIENT_ORIGIN=http://localhost:5173

# Database Connection
# Local Docker or native MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/collabsync

# Authentication & Security
# Generate a cryptographically secure key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_chars_long
JWT_EXPIRES_IN=7d
COOKIE_NAME=collabsync_token
